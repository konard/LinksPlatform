# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text diff=csharp
*.csx text diff=csharp
*.csproj text diff=csharp
*.sln text eol=crlf
*.props text
*.targets text

# Documentation
*.md text
*.txt text

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Serialization
*.json text
*.xml text
*.yml text
*.yaml text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.gz binary
*.zip binary
*.7z binary
*.tar binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
