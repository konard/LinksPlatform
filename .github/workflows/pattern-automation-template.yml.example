# GitHub Automation Pattern - Workflow Template
#
# This is a template for creating pattern-based automation workflows.
# Copy this file, remove the .example extension, and customize it for your specific automation needs.
#
# Based on the pattern extracted from issue #471 and documented in doc/articles/github-automation-pattern.md

name: Pattern-Based Automation Template

# Define when this automation should run
on:
  # Example: Run on schedule
  schedule:
    - cron: '0 0 * * 0'  # Weekly on Sunday at midnight

  # Example: Manual trigger
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Perform a dry run without creating PRs'
        required: false
        default: 'true'

jobs:
  detect-and-fix:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      # Step 1: Problem Detection
      - name: Detect pattern issues
        id: detect
        run: |
          # Add your detection logic here
          # Examples:
          # - Search for typos using grep/ripgrep
          # - Scan for deprecated API usage
          # - Check for missing files (LICENSE, README, etc.)
          # - Validate code patterns using AST tools

          echo "detected=false" >> $GITHUB_OUTPUT
          # Set to true if issues are found

      # Step 2: Generate Fix
      - name: Generate fix
        if: steps.detect.outputs.detected == 'true'
        run: |
          # Add your fix generation logic here
          # Examples:
          # - Replace typos with correct spelling
          # - Update deprecated API calls
          # - Add missing files from templates
          # - Refactor code patterns

          # Store changes for later steps

      # Step 3: Create Pull Request
      - name: Create Pull Request
        if: steps.detect.outputs.detected == 'true' && github.event.inputs.dry_run != 'true'
        uses: peter-evans/create-pull-request@v5
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          commit-message: |
            Apply automated pattern fix

            This change was automatically generated based on a detected pattern.

            Related to pattern automation initiative.
          branch: automated-pattern-fix-${{ github.run_number }}
          title: '[Automated] Apply pattern-based fix'
          body: |
            ## Automated Pattern Fix

            This PR was automatically generated by the pattern-based automation workflow.

            ### What was detected
            <!-- Describe what pattern/issue was found -->

            ### What was fixed
            <!-- Describe the applied fix -->

            ### Verification
            - [ ] Changes have been reviewed
            - [ ] Tests pass (if applicable)
            - [ ] No unintended side effects

            ---
            🤖 This is an automated pull request.
            If you have questions, please refer to the [automation pattern documentation](../doc/articles/github-automation-pattern.md).
          labels: |
            automated
            pattern-fix

      # Step 4: Report Results
      - name: Report results
        if: always()
        run: |
          if [ "${{ steps.detect.outputs.detected }}" == "true" ]; then
            echo "✅ Pattern detected and fix applied"
          else
            echo "ℹ️ No pattern issues detected"
          fi

  # Optional: Multi-repository automation
  scan-multiple-repos:
    runs-on: ubuntu-latest
    if: github.event.inputs.dry_run != 'true'

    strategy:
      matrix:
        # List repositories to scan
        # This should be generated dynamically in production
        repo: []
        # repo: ['owner/repo1', 'owner/repo2']

    steps:
      - name: Process repository
        run: |
          echo "Processing ${{ matrix.repo }}"
          # Add logic to:
          # 1. Clone the repository
          # 2. Detect pattern
          # 3. Apply fix
          # 4. Create PR using GitHub API
          #
          # IMPORTANT: Respect rate limits and community guidelines
          # Consider adding delays between operations
