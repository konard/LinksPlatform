            "en": "I",
            "ru": "я",
            "es": "yo",
            "fr": "je",
            "de": "ich",
            "zh": "我"
          }
        },
        "you": {
          "definition": "Second person - the addressee",
          "languages": {
            "en": "you",
            "ru": "ты",
            "es": "tú",
            "fr": "tu",
            "de": "du",
            "zh": "你"
          }
        },
        "someone": {
          "definition": "Indefinite person",
