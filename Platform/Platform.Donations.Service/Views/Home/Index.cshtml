@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>Platform Donations</h1>
    <p class="lead">Support creators and projects with recurrent donations</p>
</div>

<div class="features">
    <div class="feature">
        <h3>Recurrent Donations</h3>
        <p>Set up weekly, monthly, or yearly donations to support your favorite creators continuously.</p>
    </div>

    <div class="feature">
        <h3>Russia-Specific Payment Methods</h3>
        <p>Support for Mir cards, YooMoney, QIWI, WebMoney, and bank transfers.</p>
    </div>

    <div class="feature">
        <h3>Non-Profit Service</h3>
        <p>A transparent platform designed to support creators and projects that contribute to the commons.</p>
    </div>
</div>

<div class="cta">
    <h2>Ready to support a creator?</h2>
    <a href="/Donations/Create" class="btn btn-primary">Make a Donation</a>
</div>

<div class="info">
    <h2>How it works</h2>
    <ol>
        <li>Choose a creator or project to support</li>
        <li>Select your donation amount and recurrence frequency</li>
        <li>Choose your preferred payment method (Mir, YooMoney, QIWI, WebMoney, or Bank Transfer)</li>
        <li>Complete the donation and support great work!</li>
    </ol>
</div>
