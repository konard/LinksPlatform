<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Platform Donations</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" href="/">Platform Donations</a>
                <ul class="navbar-nav">
                    <li><a href="/">Home</a></li>
                    <li><a href="/Donations/Create">Make a Donation</a></li>
                    <li><a href="/Donations/MyDonations">My Donations</a></li>
                    <li><a href="/Home/About">About</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            &copy; 2025 - Platform Donations - Non-profit recurrent donation service
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
