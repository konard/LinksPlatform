@model LinkModel
@{
    Layout = null;
    ViewData["Title"] = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Model.Link.ToString());
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - Graph View</title>
    <link rel="stylesheet" href="~/css/graph/style.css">
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/cytoscape.min.js"></script>
    <script src="~/js/graph.js"></script>
</head>
<body>
    <div id="toolbar">
        <div id="toolbar-logo">links</div>
        <div id="toolbar-controls">
            <button id="btn-fit">Fit</button>
            <button id="btn-center">Center</button>
            <button id="btn-layout">Re-layout</button>
            <select id="layout-selector">
                <option value="cose">Force-directed (COSE)</option>
                <option value="circle">Circle</option>
                <option value="grid">Grid</option>
                <option value="breadthfirst">Breadth-first</option>
                <option value="concentric">Concentric</option>
            </select>
        </div>
        <div id="info">
            <span id="node-count">Nodes: 0</span>
            <span id="edge-count">Edges: 0</span>
        </div>
    </div>
    <div id="cy"></div>
    <div id="node-info" style="display:none;">
        <h3 id="node-info-title">Node Details</h3>
        <div id="node-info-content"></div>
    </div>

    <script type="text/javascript">
        // Pass model data to JavaScript
        var linkModelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    </script>
</body>
</html>
