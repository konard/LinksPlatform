@model LinkModel
@{
    ViewData["Title"] = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Model.Link.ToString());
}
<div class="link-view">
    <h2>@ViewData["Title"]</h2>
    <div class="link-description">
        @await Html.PartialAsync("LinkDescription", Model.Link)
    </div>
    <div>
        @await Html.PartialAsync("LinkReferersList", Model.ReferersModels)
    </div>
</div>