@model FactModel
@{
    ViewData["Title"] = "Create New Fact";
}

<div class="fact-create">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Content">Fact Content</label>
            <textarea asp-for="Content" class="form-control" rows="5" required></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Supporting References</label>
            <p class="help-text">
                Add URLs or citations to support this fact. Facts without references are considered drafts
                and are not shown to the public (only to logged-in users).
            </p>
            <div id="references-container">
                <input type="text" name="References" class="form-control reference-input" placeholder="https://example.com/source1" />
            </div>
            <button type="button" id="add-reference" class="btn btn-secondary btn-sm">Add Another Reference</button>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Fact</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>

    <div class="public-domain-notice">
        <hr />
        <p class="text-muted">
            <small>
                <strong>Note:</strong> All facts are in the Public Domain. Copyright is not applied to facts.
            </small>
        </p>
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 20px;
    }
    .form-control {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    .reference-input {
        margin-bottom: 10px;
    }
    .help-text {
        font-size: 0.9em;
        color: #6c757d;
        margin-bottom: 10px;
    }
    .btn {
        display: inline-block;
        padding: 6px 12px;
        margin: 5px;
        text-decoration: none;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        color: white;
    }
    .btn-primary {
        background-color: #007bff;
    }
    .btn-secondary {
        background-color: #6c757d;
    }
    .btn-sm {
        padding: 4px 8px;
        font-size: 0.9em;
    }
    .text-danger {
        color: #dc3545;
    }
    .text-muted {
        color: #6c757d;
    }
</style>

<script>
    document.getElementById('add-reference').addEventListener('click', function() {
        var container = document.getElementById('references-container');
        var input = document.createElement('input');
        input.type = 'text';
        input.name = 'References';
        input.className = 'form-control reference-input';
        input.placeholder = 'https://example.com/source' + (container.children.length + 1);
        container.appendChild(input);
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
