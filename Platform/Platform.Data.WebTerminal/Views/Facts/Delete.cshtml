@model FactModel
@{
    ViewData["Title"] = $"Delete Fact #{Model.Id}";
}

<div class="fact-delete">
    <h2>@ViewData["Title"]</h2>

    <div class="alert alert-danger">
        <strong>Warning:</strong> Are you sure you want to delete this fact?
    </div>

    <div class="fact-preview">
        <h3>Fact Content</h3>
        <p>@Model.Content</p>

        <h3>References</h3>
        @if (Model.References.Any())
        {
            <ul>
                @foreach (var reference in Model.References)
                {
                    <li>@reference</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No references</p>
        }
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border: 1px solid transparent;
        border-radius: 4px;
    }
    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }
    .fact-preview {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 20px;
    }
    .btn {
        display: inline-block;
        padding: 6px 12px;
        margin: 5px;
        text-decoration: none;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        color: white;
    }
    .btn-danger {
        background-color: #dc3545;
    }
    .btn-secondary {
        background-color: #6c757d;
    }
    .text-muted {
        color: #6c757d;
    }
</style>
